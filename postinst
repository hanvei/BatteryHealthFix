#!/bin/bash
# BatteryHealthFix postinst —— 安装后处理
# 作用：重启 SpringBoard 和 BatteryService 让 Tweak 生效

echo "[BatteryHealthFix] postinst 开始执行..."

# 杀掉 BatteryService（iOS 会自动重启）
if [ -d /System/Library/LaunchDaemons ]; then
    killall BatteryService 2>/dev/null || true
    echo "[BatteryHealthFix] BatteryService 已重启"
fi

# 设置 Tweak 库权限
chown root:wheel /Library/Tweaks/BatteryHealthFix.dylib 2>/dev/null || true
chmod 0644 /Library/Tweaks/BatteryHealthFix.dylib 2>/dev/null || true

# 重启 SpringBoard（让设置界面的 Hook 生效）
killall SpringBoard 2>/dev/null || true
echo "[BatteryHealthFix] SpringBoard 已重启"

echo "[BatteryHealthFix] postinst 完成"
