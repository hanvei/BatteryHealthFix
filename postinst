#!/bin/bash
# BatteryHealthFix postinst —— 安装后自动处理（rootless/rootful 自适应）

DYLIB="/var/jb/Library/MobileSubstrate/DynamicLibraries/BatteryHealthFix.dylib"
[ -f "$DYLIB" ] || DYLIB="/Library/MobileSubstrate/DynamicLibraries/BatteryHealthFix.dylib"

chown root:wheel "$DYLIB" 2>/dev/null || true
chmod 0644 "$DYLIB" 2>/dev/null || true

killall BatteryService 2>/dev/null || true
killall SpringBoard 2>/dev/null || true

echo "[BatteryHealthFix] 安装完成，桌面即将重启"
